# .env.production.example - Plantilla de variables para endurecimiento estricto en producción.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PORTAL_SLUG=

UPSTASH_REDIS_REST_URL=https://your-upstash-production-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-production-token

SECURITY_RATE_LIMIT_DISTRIBUTED_TIMEOUT_MS=800

AUTH_RATE_LIMIT_REQUIRE_DISTRIBUTED=true
AUTH_RATE_LIMIT_FAIL_CLOSED=true

ADMIN_RATE_LIMIT_REQUIRE_DISTRIBUTED=true
ADMIN_RATE_LIMIT_FAIL_CLOSED=true

PLAYER_PROFILE_RATE_LIMIT_REQUIRE_DISTRIBUTED=true
PLAYER_PROFILE_RATE_LIMIT_FAIL_CLOSED=true

# Analytics: solo si quieres ingesta de telemetría en prod (requiere ambas en true).
ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ENABLED=false
ANALYTICS_RATE_LIMIT_REQUIRE_DISTRIBUTED=true
ANALYTICS_RATE_LIMIT_FAIL_CLOSED=true

# Opcionales con default seguro:
# DUEL_COMPLETION_TOKEN_SECRET=   # si vacío usa SUPABASE_SERVICE_ROLE_KEY
# TUTORIAL_FINAL_REWARD_NEXUS=    # default 600
