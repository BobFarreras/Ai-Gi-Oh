{
  "name": "ai-gi-oh",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:story:resilience": "playwright test e2e/story/story-resilience.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "quality:story": "pnpm vitest run src/core/use-cases/story src/core/services/story/world src/services/story/build-story-chapter-briefing.test.ts src/components/hub/story/internal/resolve-story-performance-profile.test.ts && pnpm lint && pnpm build",
    "security:audit:prod": "pnpm audit --prod --audit-level=high",
    "quality:check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "security:rate-limit:check": "node scripts/security/check-rate-limit-env.mjs",
    "security:rate-limit:check:staging": "node scripts/security/check-rate-limit-env.mjs --target=staging --env-file=.env.staging.example",
    "security:rate-limit:check:production": "node scripts/security/check-rate-limit-env.mjs --target=production --env-file=.env.production.example",
    "supabase:prepare:migrations": "node scripts/supabase/prepare-local-migrations.mjs",
    "supabase:start": "pnpm exec supabase start",
    "supabase:stop": "pnpm exec supabase stop",
    "supabase:db:reset:local": "pnpm exec supabase db reset --local",
    "supabase:env:local": "node scripts/supabase/setup-local-env.mjs",
    "supabase:env:apply": "node scripts/supabase/apply-local-env-to-dotenv-local.mjs",
    "supabase:env:restore": "node scripts/supabase/restore-dotenv-local.mjs",
    "supabase:bootstrap:local": "node scripts/supabase/bootstrap-local.mjs",
    "perf:baseline:mobile": "node scripts/performance/run-mobile-baseline.mjs",
    "perf:baseline:mobile:realistic": "node scripts/performance/run-mobile-baseline.mjs --profile=realistic",
    "perf:baseline:mobile:stress": "node scripts/performance/run-mobile-baseline.mjs --profile=stress",
    "perf:baseline:mobile:auto": "node scripts/performance/run-mobile-baseline.mjs --profile=both --startServer=\"pnpm dev\"",
    "perf:baseline:mobile:auto:prod": "node scripts/performance/run-mobile-baseline.mjs --profile=both --startServer=\"pnpm start\"",
    "perf:combat:e2e": "node scripts/performance/run-combat-e2e.mjs",
    "perf:combat:e2e:auto:dev": "node scripts/performance/run-combat-e2e.mjs --startServer=\"pnpm dev\"",
    "perf:combat:e2e:auto:prod": "node scripts/performance/run-combat-e2e.mjs --startServer=\"pnpm start\"",
    "perf:combat:e2e:real": "node scripts/performance/run-combat-e2e-real.mjs",
    "perf:combat:e2e:real:auto:dev": "node scripts/performance/run-combat-e2e-real.mjs --startServer=\"pnpm dev\"",
    "perf:combat:e2e:real:auto:prod": "node scripts/performance/run-combat-e2e-real.mjs --startServer=\"pnpm start\"",
    "perf:combat:e2e:real:stress:auto:prod": "node scripts/performance/run-combat-e2e-real.mjs --profile=stress --startServer=\"pnpm start\"",
    "release:tag": "node scripts/release/create-release-tag-from-package-version.mjs",
    "release:tag:push": "node scripts/release/create-release-tag-from-package-version.mjs --push"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "styled-jsx": "5.1.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^28.1.0",
    "playwright": "^1.61.0",
    "supabase": "^2.106.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
