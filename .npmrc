# Builds nativos pre-aprobados (esbuild, sharp, unrs-resolver): se declaran en
# package.json -> "pnpm.onlyBuiltDependencies", que es donde pnpm 10/11 lo lee de forma
# FIABLE. La sintaxis `only-built-dependencies[]` del .npmrc NO la respeta pnpm 11 y dejaba
# el gate ERR_PNPM_IGNORED_BUILDS activo (rompía `pnpm install` y hasta `pnpm dev`).

# No hagas auto-install/verificación antes de ejecutar scripts. En fresh clone ese auto-install
# de pnpm aborta con ERR_PNPM_IGNORED_BUILDS antes de que corra nuestro asistente; el setup hace
# `pnpm install` él mismo de forma explícita.
verify-deps-before-run=false
