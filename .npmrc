# Builds nativos pre-aprobados: pnpm los compila sin pedir `pnpm approve-builds`.
only-built-dependencies[]=esbuild
only-built-dependencies[]=sharp
only-built-dependencies[]=unrs-resolver

# No hagas auto-install antes de ejecutar scripts. En fresh clone, ese auto-install
# de pnpm ignora los build scripts y aborta con ERR_PNPM_IGNORED_BUILDS antes de que
# corra nuestro asistente. El setup hace `pnpm install` él mismo de forma explícita.
verify-deps-before-run=false
